# Dedicated 24/7 agent worker (IMAP + email HITL + payout watcher).
# Copy values into Render / Railway / Cloud Run env — NEVER commit SMTP_PASS.
#
# This is NOT hamula-api. Keep MIRAS_AGENTS_ENABLED off on the API service.
# Scale exactly one instance. Two instances = duplicate inbox replies.

NODE_ENV=production
PORT=8080
MIRAS_PROCESS_ROLE=agents
MIRAS_DEPLOY_ENV=staging
FIREBASE_PROJECT_ID=hamula-cfc6c
APP_URL=https://hamula-cfc6c.web.app

MIRAS_SUPPORT_EMAIL=support@miras.com
MIRAS_ADMIN_EMAIL=ahmed.alkhulif.12@gmail.com

# Gmail SMTP (App Password, not the account login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ahmed.alkhulif.12@gmail.com
SMTP_PASS=
SMTP_FROM=support@miras.com

# Gmail IMAP — enable IMAP in Gmail settings; same App Password is fine
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=ahmed.alkhulif.12@gmail.com
IMAP_PASS=
IMAP_POLL_MS=15000

# Avoid a boot email on every container restart / redeploy (set true to silence)
MIRAS_AGENTS_SKIP_BOOT_EMAIL=false
# Immediate bilingual acknowledgement to the customer (admin still gets the full brief)
MIRAS_AUTO_ACK=true
# Extra marketing domains to ignore (comma-separated). Built-in list already covers
# Bayt, LinkedIn, Canva, AliExpress, job boards, and similar newsletters.
# MIRAS_PROMO_DOMAINS=
# Set true to log every ignored promotional message (default: counts only)
# MIRAS_LOG_PROMO=false
# Admin digest interval (6 hours). Set 0 to disable periodic reports.
MIRAS_REPORT_INTERVAL_MS=21600000

# Optional Gemini routing (keyword fallback if unset)
# GEMINI_API_KEY=
# MIRAS_AGENT_MODEL=gemini-2.0-flash

# Cloud Run: leave Firebase Admin JSON unset and grant the runtime
# service account Cloud Datastore User so payouts can read Firestore.
# FIREBASE_SERVICE_ACCOUNT_JSON=
