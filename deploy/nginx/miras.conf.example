# Miras — nginx reverse proxy (HTTPS) example
# Replace YOUR_DOMAIN with production domain (e.g. app.miras.sa)
# TLS certificates: certbot --nginx -d YOUR_DOMAIN

upstream miras_node {
  server 127.0.0.1:3000;
  keepalive 32;
}

# Redirect HTTP → HTTPS
server {
  listen 80;
  listen [::]:80;
  server_name YOUR_DOMAIN;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name YOUR_DOMAIN;

  ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

  # Moyasar webhook + SPA + API share one origin (required for cookies/auth + callback URLs)
  location / {
    proxy_pass http://miras_node;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }

  # Optional: stricter rate limit on webhook (adjust zone in http {} block)
  location /api/webhooks/moyasar {
    proxy_pass http://miras_node;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
