# Cloud Run runtime env for Miras API (hamula-api on hamula-cfc6c)
# Copy values into Secret Manager or pass via --set-env-vars / --set-secrets on deploy.
#
# Live Firebase Hosting for this project uses MIRAS_DEPLOY_ENV=staging so
# Moyasar TEST keys (sk_test_*) are allowed. Switch to production + sk_live_*
# only when going fully live with real charges.
#
# APP_URL must match the public site users open (custom domain preferred):
#   https://hamula-cfc6c.web.app
#   https://YOUR_CUSTOM_DOMAIN
# Moyasar webhook:  {APP_URL}/api/webhooks/moyasar
# Moyasar callback: {APP_URL}/payment-callback

NODE_ENV=production
MIRAS_DEPLOY_ENV=staging
# Legacy alias (optional — deploy scripts set both)
HAMOULA_DEPLOY_ENV=staging
FIREBASE_PROJECT_ID=hamula-cfc6c
MIRAS_EXPECTED_FIREBASE_PROJECT=hamula-cfc6c
HAMOULA_EXPECTED_FIREBASE_PROJECT=hamula-cfc6c
APP_URL=https://hamula-cfc6c.web.app
APP_CHECK_ENFORCE=false
MOYASAR_SECRET_KEY=sk_test_your_key
# Optional for staging verify/deploy — defaults to whsec_test_dummy if unset
MOYASAR_WEBHOOK_SECRET=whsec_test_dummy

# Do not enable the IMAP agent on this API service (CPU sleeps at min-instances=0).
MIRAS_PROCESS_ROLE=api
# MIRAS_AGENTS_ENABLED=false

