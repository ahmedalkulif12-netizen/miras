rules_version = '2';

/**
 * Miras Firebase Storage rules — driver KYC documents.
 * Path: drivers/{uid}/documents/{docKey}/{fileName}
 */
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isAllowedDocKey(docKey) {
      return docKey in ['license', 'id', 'registration', 'permit'];
    }

    function isAllowedContentType() {
      return request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png';
    }

    match /drivers/{driverId}/documents/{docKey}/{fileName} {
      allow read: if isOwner(driverId) || isAdmin();
      allow write: if isOwner(driverId)
        && isAllowedDocKey(docKey)
        && isAllowedContentType()
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isOwner(driverId) || isAdmin();
    }

    match /operators/{operatorId}/vehicles/{vehicleId}/documents/{docKey}/{fileName} {
      allow read: if isOwner(operatorId) || isAdmin();
      allow write: if isOwner(operatorId)
        && isAllowedDocKey(docKey)
        && isAllowedContentType()
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isOwner(operatorId) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
