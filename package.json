{
  "name": "miras",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node scripts/clean-build.mjs",
    "clean:build": "node scripts/clean-build.mjs && npm run build",
    "lint": "tsc --noEmit",
    "test:auth-routing": "tsx scripts/test-auth-routing.ts",
    "verify:staging": "tsx scripts/verify-production-env.ts staging",
    "verify:production": "tsx scripts/verify-production-env.ts production",
    "verify:firebase-client": "tsx scripts/verify-firebase-client-env.ts",
    "verify:auth-domains": "tsx scripts/verify-auth-authorized-domains.ts",
    "rotate:firebase-api-key": "tsx scripts/rotate-firebase-web-api-key.ts",
    "build:production": "npm run build",
    "verify:store-client": "tsx scripts/verify-store-client.ts",
    "verify:store-client:ios": "tsx scripts/verify-store-client.ts --require-ios-plist",
    "verify:store-client:android": "tsx scripts/verify-store-client.ts --require-app-links",
    "deploy:hosting": "tsx scripts/verify-store-client.ts && npm run build && npx --yes firebase-tools deploy --only hosting --project hamula-cfc6c",
    "deploy:hosting:store": "tsx scripts/verify-store-client.ts --require-app-links && npm run build && npx --yes firebase-tools deploy --only hosting --project hamula-cfc6c",
    "cap:sync:android:store": "tsx scripts/verify-store-client.ts --require-app-links && node scripts/vite-capacitor.mjs && npx cap sync android",
    "cap:sync:ios:store": "npm run ios:prepare-store && npm run verify:ios-store && npm run cap:sync:ios",
    "deploy:hosting:preview": "npm run build && npx --yes firebase-tools hosting:channel:deploy preview --project hamula-cfc6c",
    "deploy:hosting:api": "npm run build && npx --yes firebase-tools deploy --only hosting --project hamula-cfc6c --config firebase.hosting.api.json",
    "deploy:live": "npm run verify:staging && npm run build && npx --yes firebase-tools deploy --only hosting,firestore --project hamula-cfc6c",
    "test:e2e:staging": "tsx scripts/e2e-staging-smoke.ts",
    "test:e2e:staging:dry": "tsx scripts/e2e-staging-smoke.ts --dry-run",
    "cap:sync": "node scripts/vite-capacitor.mjs && npx cap sync",
    "cap:sync:android": "node scripts/vite-capacitor.mjs && npx cap sync android",
    "cap:sync:ios": "node scripts/vite-capacitor.mjs && npx cap sync ios && node scripts/fix-ios-spm-app-check.mjs",
    "fix:ios-spm-app-check": "node scripts/fix-ios-spm-app-check.mjs",
    "generate:assets": "node scripts/generate-native-assets.mjs",
    "generate:store-screenshots": "node scripts/prepare-store-screenshots.mjs",
    "resize:ios-screenshots-65": "node scripts/resize-ios-screenshots-65.mjs",
    "ios:set-team-id": "node scripts/set-ios-team-id.mjs",
    "verify:ios-store": "node scripts/verify-ios-store.mjs",
    "ios:prepare-store": "node scripts/prepare-ios-store.mjs",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "deploy:cloud-run": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloud-run.ps1",
    "deploy:cloud-run:agents": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloud-run-agents.ps1",
    "agents": "tsx src/agents/whatsapp.js",
    "start:agents": "tsx src/agents/whatsapp.js",
    "dev:agents": "tsx src/agents/whatsapp.js",
    "verify:mail": "tsx scripts/verify-mail.mjs",
    "diag:imap": "tsx scripts/diag-imap-inbox.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-firebase/app-check": "^8.5.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^1.29.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "imapflow": "^1.7.6",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.16",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.0"
  }
}
