# =============================================================================
# First App Store / TestFlight CLIENT BUILD (hamula-cfc6c)
# Copy to `.env.production` (gitignored) BEFORE `npm run cap:sync:ios`.
# Vite production mode reads `.env.production` and bakes VITE_* into the binary.
# NEVER commit filled secrets.
# =============================================================================

NODE_ENV=production
MIRAS_DEPLOY_ENV=production
PORT=3000
APP_URL=https://hamula-cfc6c.web.app
VITE_APP_URL=https://hamula-cfc6c.web.app
VITE_MIRAS_DEPLOY_ENV=production

MIRAS_EXPECTED_FIREBASE_PROJECT=hamula-cfc6c
FIREBASE_PROJECT_ID=hamula-cfc6c

# Copy the same VITE_FIREBASE_* / Maps values from your working `.env`
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hamula-cfc6c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hamula-cfc6c
VITE_FIREBASE_STORAGE_BUCKET=hamula-cfc6c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=191963635866
# Must be the Web app id (1:191963635866:web:…). Never paste the iOS/Android id here.
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Universal Links (public Team ID — already applied in AASA / Xcode)
VITE_IOS_TEAM_ID=4TRJXRYK8A
# Play Console → App integrity → App signing → SHA-256 (colon-separated)
# VITE_ANDROID_SHA256_CERT_FINGERPRINTS=

# Store binary: App Check on. Do not ship debug tokens or disabled App Check.
VITE_APP_CHECK_DISABLED=false
VITE_APP_CHECK_RECAPTCHA_SITE_KEY=6Lf0czctAAAAAF7EECTuyfcTMJpA7HCTBlLp7Syb
# DO NOT SET VITE_APP_CHECK_DEBUG_TOKEN, VITE_ENABLE_DEV_AUTH_BYPASS, or VITE_PHONE_AUTH_TESTING
APP_CHECK_ENFORCE=true

# Public listing
VITE_SUPPORT_EMAIL=support@miras.com
MIRAS_SUPPORT_EMAIL=support@miras.com
SMTP_FROM=support@miras.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Transport login only (never shown in the app). Fill locally — never commit.
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_POLL_MS=15000
MIRAS_AGENTS_ENABLED=true
# MIRAS_ADMIN_EMAIL=you@your-domain.com

# Moyasar — use sk_live_* for production charges. Test keys only for local/dev API.
# Production charges require sk_live_* + MOYASAR_WEBHOOK_SECRET on the API host.
MOYASAR_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
MOYASAR_WEBHOOK_SECRET=whsec_live_xxxxxxxx

# Leave unset — Hosting rewrites /api/** to Cloud Run
# VITE_API_ORIGIN=
