# =============================================================================
# Miras STAGING / live Hosting (hamula-cfc6c) — Moyasar TEST keys
# MIRAS_DEPLOY_ENV=staging keeps sk_test_* + relaxed App Check
# Use this for the public Firebase Hosting site until real charges are enabled.
# NEVER commit filled secrets.
# =============================================================================

NODE_ENV=production
MIRAS_DEPLOY_ENV=staging
PORT=8080

# Public site users open (custom domain or default Hosting URL)
APP_URL=https://hamula-cfc6c.web.app

# Pin Firebase project to prevent accidental cross-wire
MIRAS_EXPECTED_FIREBASE_PROJECT=hamula-cfc6c
FIREBASE_PROJECT_ID=hamula-cfc6c
# On Cloud Run, ADC is automatic — leave GOOGLE_APPLICATION_CREDENTIALS unset.

# Moyasar TEST keys only (checkout will fail if MOYASAR_SECRET_KEY is missing on Cloud Run)
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Optional until webhooks are enabled — verify/deploy apply whsec_test_dummy if unset
MOYASAR_WEBHOOK_SECRET=whsec_test_dummy
# Optional publishable key for future Moyasar.js Apple Pay:
# VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# App Check optional until Console enforcement is ON
APP_CHECK_ENFORCE=false
# Temporary staging bypass — set false before enforcing Auth App Check in Console
VITE_APP_CHECK_DISABLED=true

# Build-time client vars (inject BEFORE `npm run build` / `firebase deploy --only hosting`)
VITE_MIRAS_DEPLOY_ENV=staging
VITE_APP_URL=https://hamula-cfc6c.web.app
VITE_SUPPORT_EMAIL=support@miras.com
# Apple Team ID for Universal Links
VITE_IOS_TEAM_ID=4TRJXRYK8A
# Leave VITE_API_ORIGIN unset — Hosting rewrites /api/** and /health to Cloud Run.
# VITE_API_ORIGIN=
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=hamula-cfc6c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hamula-cfc6c
VITE_FIREBASE_STORAGE_BUCKET=hamula-cfc6c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=191963635866
VITE_FIREBASE_APP_ID=1:191963635866:web:xxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_MAPS_PLATFORM_KEY=your_google_maps_browser_key
VITE_APP_CHECK_RECAPTCHA_SITE_KEY=6Lf0czctAAAAAF7EECTuyfcTMJpA7HCTBlLp7Syb
# VITE_APP_CHECK_DEBUG_TOKEN=staging-debug-token-uuid

# Moyasar dashboard:
# - Webhook URL:  https://hamula-cfc6c.web.app/api/webhooks/moyasar
# - Callback URL: https://hamula-cfc6c.web.app/payment-callback
# (Update both when a custom domain is attached.)

# Support Agent placeholders (fill SMTP_PASS / IMAP_PASS on the API host)
MIRAS_SUPPORT_EMAIL=support@miras.com
SMTP_FROM=support@miras.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

# E2E smoke (docs/E2E_STAGING.md)
# E2E_STAGING=true
# E2E_ALLOWED_FIREBASE_PROJECT=hamula-cfc6c
# E2E_BASE_URL=https://hamula-cfc6c.web.app
