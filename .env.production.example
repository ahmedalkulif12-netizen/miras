# =============================================================================
# Miras PRODUCTION — set on host ONLY (Railway/Render/VPS secret manager)
# NEVER commit filled values — gitignored via .env*
# =============================================================================

NODE_ENV=production
MIRAS_DEPLOY_ENV=production
PORT=3000
APP_URL=https://app.YOUR_DOMAIN.com

# Hard pin — server refuses start if FIREBASE_PROJECT_ID differs
MIRAS_EXPECTED_FIREBASE_PROJECT=hamula-prod
FIREBASE_PROJECT_ID=hamula-prod
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-prod-sa.json

# Moyasar LIVE (Mada / Visa / Apple Pay hosted checkout)
MOYASAR_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
MOYASAR_WEBHOOK_SECRET=whsec_live_xxxxxxxx
# Optional — only if adding Moyasar.js Apple Pay button later:
# VITE_MOYASAR_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxx
# Webhook: https://app.YOUR_DOMAIN.com/api/webhooks/moyasar
# Callback: https://app.YOUR_DOMAIN.com/payment-callback

# Required after Firebase Console App Check enforcement
APP_CHECK_ENFORCE=true

# Build-time client vars (set in CI/host BEFORE npm run build — baked into dist/)
VITE_MIRAS_DEPLOY_ENV=production
VITE_APP_URL=https://app.YOUR_DOMAIN.com
VITE_SUPPORT_EMAIL=support@miras.com
# Play App Signing SHA-256 (colon-separated hex) — required for Android App Links.
# VITE_ANDROID_SHA256_CERT_FINGERPRINTS=AB:CD:EF:...
# Apple Universal Links (public Team ID)
VITE_IOS_TEAM_ID=4TRJXRYK8A
# Leave unset when Firebase Hosting rewrites /api/** to Cloud Run on the same domain.
# Set only for split-host deployments (SPA on Hosting, API on a different origin).
# VITE_API_ORIGIN=https://hamoula-api-xxxxxxxx-uc.a.run.app
VITE_FIREBASE_API_KEY=prod_firebase_web_key
VITE_FIREBASE_AUTH_DOMAIN=hamula-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hamula-prod
VITE_FIREBASE_STORAGE_BUCKET=hamula-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_MAPS_PLATFORM_KEY=prod_maps_browser_key
VITE_APP_CHECK_DISABLED=false
VITE_APP_CHECK_RECAPTCHA_SITE_KEY=6Lf0czctAAAAAF7EECTuyfcTMJpA7HCTBlLp7Syb

# Support Agent — run as a *separate* 24/7 worker (`deploy/agents.env.example`),
# not inside hamula-api (that Cloud Run service sleeps between requests).
MIRAS_SUPPORT_EMAIL=support@miras.com
SMTP_FROM=support@miras.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_POLL_MS=15000
MIRAS_AGENTS_ENABLED=true

# Production Phone Auth: remove ALL "Phone numbers for testing" from Firebase Console
# (Authentication → Sign-in method → Phone) so real SMS is sent.

# DO NOT SET on production:
# VITE_APP_CHECK_DEBUG_TOKEN
# E2E_STAGING
