# =============================================================================
# Miras Environment Variables (P0-15)
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit `.env` — it is gitignored.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
MIRAS_DEPLOY_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# =============================================================================
# 1) OTP / Firebase Phone Auth (Saudi +966)
# =============================================================================
# Client (VITE_*) — Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=hamula-cfc6c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hamula-cfc6c
VITE_FIREBASE_STORAGE_BUCKET=hamula-cfc6c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=191963635866
VITE_FIREBASE_APP_ID=1:191963635866:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App Check (required when Authentication App Check enforcement is ON)
# Dev debug token: Firebase Console → App Check → Manage debug tokens
# VITE_APP_CHECK_DEBUG_TOKEN=your-debug-token-uuid
VITE_APP_CHECK_RECAPTCHA_SITE_KEY=6Lf0czctAAAAAF7EECTuyfcTMJpA7HCTBlLp7Syb
# Leave false for real OTP. Only set true for emergency local debugging.
# VITE_APP_CHECK_DISABLED=false

# Server Firebase Admin (session minting after OTP / order publish)
FIREBASE_PROJECT_ID=hamula-cfc6c
# Local `npm run dev` does NOT need a service-account JSON. Missing credentials no longer
# 500 publish-after-checkout — the API writes with the user ID token or returns
# clientWriteRequired so the browser creates `orders/{id}` (rules: auth + userId == uid).
# Preferred on Cloud Run / VPS (paste the service-account JSON as one line):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"hamula-cfc6c",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hamula-cfc6c.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# APP_CHECK_ENFORCE=false

# Production OTP checklist (Firebase Console):
# - Enable Phone sign-in method
# - Add your production domain under Authentication → Settings → Authorized domains
# - REMOVE all "Phone numbers for testing" so real SMS is sent to +9665xxxxxxxx
# - Enable SMS billing / Identity Toolkit for Saudi numbers
# See: docs/FIREBASE_AUTH_SETUP.md

# Optional: skip real reCAPTCHA for Console *test* phone numbers only (local).
# Leave unset/false for real SMS. Enabling this with a live number causes captcha MALFORMED.
# Hostname `localhost` enables this automatically. Keep unset on 127.0.0.1 for real SMS.
# VITE_PHONE_AUTH_TESTING=true

# Optional: local screenshot / E2E bypass WITHOUT SMS OTP (loopback + private LAN during `npm run dev`).
# Demo Login buttons (Customer / Driver) appear automatically. Test number: 0500000000 (skips OTP).
# Enable Anonymous in Firebase Console → Authentication → Sign-in method for Firestore writes.
# Do NOT set in staging/prod. Production Vite builds never show this UI.
# VITE_ENABLE_DEV_AUTH_BYPASS=true

# =============================================================================
# 2) Payment Gateway — Moyasar (Mada / Visa / Apple Pay)
# =============================================================================
# Server-only secrets (NEVER use VITE_ prefix — never expose to the browser)
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Staging/local may use the dummy below until you create a Moyasar webhook secret.
# Production MUST replace this with the real dashboard value.
MOYASAR_WEBHOOK_SECRET=whsec_test_dummy

# Optional publishable key (pk_test_ / pk_live_) — needed only if you add Moyasar.js
# client-side Apple Pay button later. Hosted checkout works with SECRET_KEY alone.
# VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# Moyasar dashboard setup:
# - Webhook URL:  {APP_URL}/api/webhooks/moyasar
# - Callback URL: {APP_URL}/payment-callback
# - Enable Mada + credit cards; enable Apple Pay + host apple-developer-merchantid-domain-association
# - Test: sk_test_* / Staging only | Production: sk_live_* + HTTPS APP_URL

# =============================================================================
# Other client public config
# =============================================================================
# Google Maps Platform browser key (restrict by HTTP referrer in Cloud Console).
# Enable billing + these APIs on the same GCP project as the key:
#   Maps JavaScript API, Places API, Geocoding API, Directions API, Routes API
# GPS/live tracking uses device Geolocation + Firestore (no Maps key required for GPS itself).
VITE_GOOGLE_MAPS_PLATFORM_KEY=your_google_maps_browser_key
# Optional alias (used if PLATFORM_KEY is empty):
# VITE_GOOGLE_MAPS_API_KEY=

# Deploy target baked into client build (development | staging | production)
# VITE_MIRAS_DEPLOY_ENV=development

# Optional: public HTTPS origin used as Moyasar callback (required for native store builds).
# Defaults to https://{VITE_FIREBASE_PROJECT_ID}.web.app when unset.
# VITE_APP_URL=https://hamula-cfc6c.web.app
# Android App Links (Play Console → App integrity → App signing key certificate SHA-256):
# VITE_ANDROID_SHA256_CERT_FINGERPRINTS=AB:CD:...
# Apple Universal Links — 10-character Team ID from https://developer.apple.com/account → Membership.
# Apply everywhere with: node scripts/set-ios-team-id.mjs YOURTEAMID
VITE_IOS_TEAM_ID=4TRJXRYK8A
# Leave unset for same-origin (`npm run dev` / Firebase Hosting rewrites /api/** → Cloud Run).
# VITE_API_ORIGIN=https://api.YOUR_DOMAIN.com

# Optional: server refuses start if FIREBASE_PROJECT_ID differs (staging/prod hosts)
# MIRAS_EXPECTED_FIREBASE_PROJECT=hamula-cfc6c

# =============================================================================
# E2E staging smoke tests (docs/E2E_STAGING.md) — NEVER use production UIDs/keys
# =============================================================================
# E2E_STAGING=true
# E2E_ALLOWED_FIREBASE_PROJECT=hamula-cfc6c
# E2E_BASE_URL=http://localhost:3000
# E2E_CUSTOMER_UID=e2e_customer_001
# E2E_DRIVER_A_UID=e2e_driver_a_001
# E2E_DRIVER_B_UID=e2e_driver_b_001
# E2E_UID_PREFIX=e2e_
# E2E_APP_CHECK_TOKEN=

# =============================================================================
# Multi-agent supervisor (LangGraph.js + email / Nodemailer)
# Node-only — never imported by the Vite/Capacitor client.
# =============================================================================
# Local: true starts agents inside `npm run dev`. Cloud API: leave unset / false
# and run the dedicated worker (`npm run start:agents` / hamula-agents).
MIRAS_AGENTS_ENABLED=true
MIRAS_SUPPORT_EMAIL=support@miras.com
MIRAS_ADMIN_EMAIL=ahmed.alkulif.12@gmail.com
# Optional Gemini routing (falls back to keywords if unset)
# GEMINI_API_KEY=
# MIRAS_AGENT_MODEL=gemini-2.0-flash
# Gmail SMTP (no Ethereal). SMTP_PASS = Google App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Transport login only (not shown in the app). Use a Gmail App Password if sending via Gmail.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@miras.com
# Gmail IMAP — watch the inbox that receives mail forwarded from support@miras.com.
# Defaults to SMTP_USER / SMTP_PASS if IMAP_USER / IMAP_PASS are empty.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_POLL_MS=15000
# Immediate customer acknowledgement (default true). Admin still gets a full brief.
MIRAS_AUTO_ACK=true
# Admin operational digest interval in ms (21600000 = 6 hours). 0 disables.
MIRAS_REPORT_INTERVAL_MS=21600000
# Set true to skip the startup report email on each process start.
# MIRAS_AGENTS_SKIP_BOOT_EMAIL=true

# Public support (baked into the client — VITE_* only)
VITE_SUPPORT_EMAIL=support@miras.com
# Optional — omit until you have a public business line (do not ship 5X XXX XXXX)
# VITE_SUPPORT_PHONE_DISPLAY=+966 5XXXXXXXX
# VITE_SUPPORT_PHONE_TEL=+9665XXXXXXXX
# VITE_SUPPORT_WHATSAPP=9665XXXXXXXX

#   .env.staging.example    → MIRAS_DEPLOY_ENV=staging
#   .env.production.example → MIRAS_DEPLOY_ENV=production
# Full guide: docs/PRODUCTION_LAUNCH.md
# =============================================================================
# - MIRAS_DEPLOY_ENV=production requires sk_live_*, HTTPS APP_URL, APP_CHECK_ENFORCE=true
# - MIRAS_DEPLOY_ENV=staging blocks sk_live_* (use sk_test_* only)
# - Run: npm run verify:production | npm run verify:staging
# =============================================================================
